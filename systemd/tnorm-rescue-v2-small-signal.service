[Unit]
Description=TNormFilter rescue-v2 small-signal micro matrix
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/lebedeffson/Code/андрей/TNormFilter_handoff
Environment=PYTHONPATH=/home/lebedeffson/Code/андрей/TNormFilter_handoff/scripts
ExecStart=/home/lebedeffson/Code/андрей/TNormFilter_handoff/.venv/bin/python -u scripts/run_micro_matrix_v2.py --wait-for-m1
