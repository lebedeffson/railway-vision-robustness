[Unit]
Description=TNormFilter canonical v3 person-safety OOF pipeline
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/lebedeffson/Code/андрей/TNormFilter_handoff
ExecStartPre=/usr/bin/mkdir -p /home/lebedeffson/Code/андрей/TNormFilter_handoff/outputs/person_v3/logs
ExecStart=/home/lebedeffson/Code/андрей/TNormFilter_handoff/.venv/bin/python -u scripts/person_v3/run_pipeline.py
Restart=on-failure
RestartSec=30
Nice=5
IOSchedulingClass=idle
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/lebedeffson/Code/андрей/TNormFilter_handoff:/home/lebedeffson/Code/андрей/TNormFilter_handoff/scripts
Environment=CUDA_VISIBLE_DEVICES=0
StandardOutput=append:/home/lebedeffson/Code/андрей/TNormFilter_handoff/outputs/person_v3/logs/pipeline.log
StandardError=append:/home/lebedeffson/Code/андрей/TNormFilter_handoff/outputs/person_v3/logs/pipeline.log

[Install]
WantedBy=default.target
