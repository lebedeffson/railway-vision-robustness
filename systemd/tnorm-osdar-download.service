[Unit]
Description=Low-impact OSDaR23 selective downloader
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lebedeffson/Code/андрей/TNormFilter_handoff
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --who=tnorm-practice --why=OSDaR23-download --mode=block /usr/bin/python download_osdar23_direct.py --workers 3 --rate-limit 12M
Restart=on-failure
RestartSec=300
Nice=15
CPUWeight=10
IOWeight=10
CPUQuota=50%
MemoryHigh=3G

[Install]
WantedBy=default.target
