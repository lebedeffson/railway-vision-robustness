[Unit]
Description=Fast OSDaR23 selective downloader shard %i
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lebedeffson/Code/андрей/TNormFilter_handoff
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --who=tnorm-practice --why=OSDaR23-download --mode=block /usr/bin/python download_osdar23_direct.py --workers 3 --rate-limit 16M --shard-count 2 --shard-index %i
Restart=on-failure
RestartSec=180
Nice=10
CPUWeight=50
IOWeight=50
CPUQuota=100%
MemoryHigh=2560M

[Install]
WantedBy=default.target
