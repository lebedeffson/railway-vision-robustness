[Unit]
Description=Fast OSDaR23 selective downloader shard %i
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lebedeffson/Code/андрей/TNormFilter_handoff
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --who=tnorm-practice --why=OSDaR23-download --mode=block /usr/bin/python download_osdar23_direct.py --workers 4 --rate-limit 24M --shard-count 2 --shard-index %i
Restart=on-failure
RestartSec=180
Nice=10
CPUWeight=50
IOWeight=75
CPUQuota=150%
MemoryHigh=2560M
MemoryMax=3G
OOMPolicy=stop
OOMScoreAdjust=300
TasksMax=64

[Install]
WantedBy=default.target
