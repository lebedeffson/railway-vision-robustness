[Unit]
Description=TNormFilter M4 expedited fold-0 triage watcher
After=tnorm-canonical-m4.service

[Service]
Type=simple
WorkingDirectory=/home/lebedeffson/Code/андрей/TNormFilter_handoff
ExecStart=/home/lebedeffson/Code/андрей/TNormFilter_handoff/.venv/bin/python -u scripts/run_canonical_m4_expedited_triage.py
Restart=on-failure
RestartSec=30
Nice=10
IOSchedulingClass=idle
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_VISIBLE_DEVICES=0
StandardOutput=append:/home/lebedeffson/Code/андрей/TNormFilter_handoff/outputs/canonical_m4/logs/expedited_triage.log
StandardError=append:/home/lebedeffson/Code/андрей/TNormFilter_handoff/outputs/canonical_m4/logs/expedited_triage.log

[Install]
WantedBy=default.target

