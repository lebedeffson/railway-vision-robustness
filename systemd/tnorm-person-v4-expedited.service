[Unit]
Description=TNormFilter canonical v4 expedited A1/A3 selection
After=graphical-session.target
ConditionPathExists=/home/lebedeffson/Code/андрей/TNormFilter_handoff/outputs/person_v4_expedited/protocol/protocol_lock.json
ConditionPathExists=!/home/lebedeffson/Code/андрей/TNormFilter_handoff/outputs/person_v3/test/TEST_OPENED.json

[Service]
Type=oneshot
WorkingDirectory=/home/lebedeffson/Code/андрей/TNormFilter_handoff
ExecStart=/home/lebedeffson/Code/андрей/TNormFilter_handoff/.venv/bin/python -u scripts/person_v4/run_expedited.py
Restart=on-failure
RestartSec=30
Nice=5
IOSchedulingClass=idle
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/lebedeffson/Code/андрей/TNormFilter_handoff:/home/lebedeffson/Code/андрей/TNormFilter_handoff/scripts
Environment=CUDA_VISIBLE_DEVICES=0
StandardOutput=journal
